   "Properties": {
    "RoleName": {
     "Fn::Sub": "coderhelm-${Stage}-deploy-stack"
    },
    "Description": "CoderHelm: applies a reviewed release's stack update when auto-update is on (docs/self-host/security.md)",
    "AssumeRolePolicyDocument": {
     "Version": "2012-10-17",
     "Statement": [
      {
       "Effect": "Allow",
       "Principal": {
        "Service": "cloudformation.amazonaws.com"
       },
       "Action": "sts:AssumeRole",
       "Condition": {
        "StringEquals": {
         "aws:SourceAccount": {
          "Ref": "AWS::AccountId"
         }
        },
        "StringLike": {
         "aws:SourceArn": [
          {
           "Fn::Sub": "arn:${AWS::Partition}:cloudformation:${AWS::Region}:${AWS::AccountId}:stack/coderhelm-${Stage}/*"
          },
          {
           "Fn::Sub": "arn:${AWS::Partition}:cloudformation:${AWS::Region}:${AWS::AccountId}:stack/coderhelm-${Stage}-*/*"
          }
         ]
        }
       }
      }
     ]
    },
    "PermissionsBoundary": {
     "Ref": "DeployBoundary"
    },
    "Policies": [
     {
      "PolicyName": "deploy",
      "PolicyDocument": {
       "Version": "2012-10-17",
       "Statement": [
        {
