        "cloudformation:*",
        "cloudfront:*",
        "cloudwatch:*",
        "codebuild:*",
        "cognito-idp:*",
        "dynamodb:*",
        "events:*",
        "kms:*",
        "lambda:*",
        "logs:*",
        "s3:*",
        "scheduler:*",
        "secretsmanager:*",
        "ses:*",
        "sns:*",
        "sqs:*",
        "ssm:*",
        "sts:AssumeRole",
        "sts:GetCallerIdentity"
       ],
       "Resource": "*"
      },
      {
       "Sid": "InstallRoleWrites",
       "Effect": "Allow",
       "Action": [
        "iam:CreateRole",
        "iam:PutRolePolicy",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:PutRolePermissionsBoundary"
       ],
       "Resource": {
        "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/coderhelm-${Stage}-*"
       },
       "Condition": {
        "StringEquals": {
         "iam:PermissionsBoundary": {
          "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:policy/coderhelm-${Stage}-boundary-stack"
         }
        }
       }
      },
      {
       "Sid": "InstallRoles",
       "Effect": "Allow",
       "Action": [
        "iam:Get*",
        "iam:List*",
        "iam:DeleteRole",
        "iam:UpdateRole*",
        "iam:UpdateAssumeRolePolicy",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:PassRole"
       ],
       "Resource": {
        "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/coderhelm-${Stage}-*"
       }
      },
      {
       "Sid": "InstallPolicies",
       "Effect": "Allow",
       "Action": [
        "iam:CreatePolicy*",
        "iam:DeletePolicy*",
        "iam:Get*",
        "iam:List*",
        "iam:TagPolicy",
        "iam:UntagPolicy"
       ],
       "Resource": {
        "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:policy/coderhelm-${Stage}-*"
