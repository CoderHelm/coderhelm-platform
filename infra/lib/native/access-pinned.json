{
 "about": "The parent's Boundary, DeployBoundary and DeployRole exactly as every native release from v0.8.36 to v0.8.53 carried them. Updates never change these three (an update runs as the deploy role, which may not change itself or a boundary); newer permissions reach an install through its access stack (access.json). Changing this file makes every install's next update wait for an AWS admin.",
 "since": "v0.8.36",
 "resources": {
  "Boundary": {
   "Type": "AWS::IAM::ManagedPolicy",
   "DeletionPolicy": "Delete",
   "UpdateReplacePolicy": "Retain",
   "Properties": {
    "ManagedPolicyName": {
     "Fn::Sub": "coderhelm-${Stage}-boundary-stack"
    },
    "Description": "CoderHelm: the most any CoderHelm role can do (docs/self-host/security.md)",
    "PolicyDocument": {
     "Version": "2012-10-17",
     "Statement": [
      {
       "Sid": "CoderHelmServices",
       "Effect": "Allow",
