      "Version": "2012-10-17"
    }
  ],
  "boundary": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "CoderHelmServices",
        "Effect": "Allow",
        "Action": [
          "acm:*",
          "apigateway:*",
          "bedrock:InvokeModel",
          "bedrock:InvokeModelWithResponseStream",
          "bedrock:Get*",
          "bedrock:List*",
          "cloudformation:*",
          "cloudfront:*",
          "cloudwatch:*",
          "codebuild:*",
          "cognito-idp:*",
          "dynamodb:*",
          "events:*",
          "kms:*",
          "lambda:*",
          "logs:*",
          "s3:*",
          "scheduler:*",
          "secretsmanager:*",
          "ses:*",
          "sns:*",
          "sqs:*",
          "ssm:*",
          "sts:AssumeRole",
          "sts:GetCallerIdentity"
        ],
        "Resource": "*"
      },
      {
        "Sid": "InstallRoleWrites",
        "Effect": "Allow",
        "Action": [
          "iam:CreateRole",
          "iam:PutRolePolicy",
          "iam:AttachRolePolicy",
          "iam:DetachRolePolicy",
          "iam:DeleteRolePolicy",
          "iam:PutRolePermissionsBoundary"
        ],
        "Resource": "arn:aws:iam::111122223333:role/coderhelm-prod-*",
        "Condition": {
          "StringEquals": {
            "iam:PermissionsBoundary": "arn:aws:iam::111122223333:policy/coderhelm-prod-boundary-stack"
          }
        }
      },
      {
        "Sid": "InstallRoles",
        "Effect": "Allow",
        "Action": [
          "iam:Get*",
          "iam:List*",
          "iam:DeleteRole",
          "iam:UpdateRole*",
          "iam:UpdateAssumeRolePolicy",
          "iam:TagRole",
          "iam:UntagRole",
          "iam:PassRole"
        ],
        "Resource": "arn:aws:iam::111122223333:role/coderhelm-prod-*"
      },
      {
        "Sid": "InstallPolicies",
        "Effect": "Allow",
        "Action": [
          "iam:CreatePolicy*",
          "iam:DeletePolicy*",
          "iam:Get*",
          "iam:List*",
          "iam:TagPolicy",
          "iam:UntagPolicy"
        ],
        "Resource": "arn:aws:iam::111122223333:policy/coderhelm-prod-*"
      },
      {
        "Sid": "NoDnsChanges",
        "Effect": "Deny",
        "Action": [
          "route53:ChangeResourceRecordSets",
          "route53:CreateHostedZone",
          "route53:DeleteHostedZone"
        ],
        "Resource": "*"
      },
      {
        "Sid": "NoIamUsersOrKeys",
        "Effect": "Deny",
        "Action": [
          "iam:*User*",
          "iam:*AccessKey*",
          "iam:*LoginProfile*",
          "iam:*Group*",
          "iam:*ServiceSpecificCredential*",
          "iam:*SSHPublicKey*",
          "iam:Create*Provider",
          "iam:UpdateAccountPasswordPolicy",
          "iam:CreateAccountAlias"
        ],
        "Resource": "*"
      },
      {
        "Sid": "NoAccountGuardrailChanges",
        "Effect": "Deny",
        "Action": [
          "organizations:*",
          "account:*",
          "cloudtrail:*",
          "guardduty:*"
        ],
        "Resource": "*"
      },
      {
        "Sid": "NoIamOutsideTheInstall",
        "Effect": "Deny",
        "Action": "iam:*",
        "NotResource": [
          "arn:aws:iam::111122223333:role/coderhelm-prod-*",
          "arn:aws:iam::111122223333:policy/coderhelm-prod-*"
        ]
      },
      {
        "Sid": "RolesOnlyWithTheBoundary",
        "Effect": "Deny",
        "Action": [
          "iam:CreateRole",
          "iam:PutRolePolicy",
          "iam:AttachRolePolicy",
          "iam:DetachRolePolicy",
          "iam:DeleteRolePolicy",
          "iam:PutRolePermissionsBoundary"
        ],
        "Resource": "*",
        "Condition": {
          "StringNotEquals": {
            "iam:PermissionsBoundary": "arn:aws:iam::111122223333:policy/coderhelm-prod-boundary-stack"
          }
        }
      },
      {
        "Sid": "TheBoundaryStays",
        "Effect": "Deny",
        "Action": [
          "iam:DeleteRolePermissionsBoundary",
          "iam:CreatePolicy*",
          "iam:DeletePolicy*",
          "iam:SetDefault*",
          "iam:*agPolicy"
        ],
        "Resource": [
          "arn:aws:iam::111122223333:policy/coderhelm-prod-*boundary-stack",
          "arn:aws:iam::111122223333:role/*"
        ]
      },
      {
        "Sid": "OnlyTheInstallsOwn",
        "Effect": "Deny",
        "Action": [
          "lambda:CreateF*",
          "lambda:CreateAlias",
          "lambda:Delete*",
          "lambda:Update*",
          "lambda:Invoke*",
          "lambda:Put*",
          "lambda:*Permission",
          "lambda:Publish*",
          "cloudformation:Create*",
          "cloudformation:Update*",
          "cloudformation:Delete*",
          "cloudformation:Execute*",
          "cloudformation:Set*",
          "cloudformation:Continue*",
          "s3:Put*",
          "s3:Delete*",
          "secretsmanager:GetSecretValue",
          "secretsmanager:Put*",
          "secretsmanager:Update*",
          "secretsmanager:Delete*",
          "ssm:Put*",
          "ssm:Delete*"
        ],
        "NotResource": [
          "arn:*:lambda:*:*:function:coderhelm-prod-*",
          "arn:*:lambda:*:*:layer:coderhelm-prod-*",
          "arn:*:lambda:*:*:event-source-mapping:*",
          "arn:*:cloudformation:*:*:stack/coderhelm-prod*",
          "arn:*:cloudformation:*:aws:transform/*",
          "arn:*:s3:::coderhelm-prod-*",
          "arn:*:s3:::coderhelm-setup-*",
          "arn:*:secretsmanager:*:*:secret:coderhelm/prod/*",
          "arn:*:ssm:*:*:parameter/coderhelm-prod/*"
        ]
      },
      {
        "Sid": "NoCommandsOnInstances",
        "Effect": "Deny",
        "Action": [
          "ssm:SendCommand",
          "ssm:Start*",
          "ssm:*Association*"
        ],
        "Resource": "*"
      },
      {
        "Sid": "TheDeployRoleStays",
        "Effect": "Deny",
        "Action": [
          "iam:CreateRole",
          "iam:PutRolePolicy",
          "iam:AttachRolePolicy",
          "iam:DetachRolePolicy",
          "iam:DeleteRolePolicy",
          "iam:PutRolePermissionsBoundary",
          "iam:DeleteRole",
          "iam:UpdateRole",
          "iam:UpdateAssumeRolePolicy",
          "iam:TagRole",
          "iam:UntagRole"
        ],
        "Resource": "arn:aws:iam::111122223333:role/coderhelm-prod-deploy-stack"
      },
      {
        "Sid": "TheAccessStackStays",
        "Effect": "Deny",
        "Action": [
          "cloudformation:CreateChangeSet",
          "cloudformation:ExecuteChangeSet",
          "cloudformation:UpdateStack",
          "cloudformation:DeleteStack",
          "cloudformation:CreateStack",
          "cloudformation:SetStackPolicy"
        ],
        "Resource": "arn:aws:cloudformation:us-east-1:111122223333:stack/coderhelm-prod-access/*"
      },
      {
        "Sid": "NoOtherRolesHere",
        "Effect": "Deny",
        "Action": [
          "sts:AssumeRole",
          "sts:AssumeRoleWithWebIdentity",
          "sts:AssumeRoleWithSAML",
          "sts:TagSession",
          "sts:SetSourceIdentity"
        ],
        "NotResource": [
          "arn:aws:iam::111122223333:role/CoderHelmLogReader",
          "arn:aws:iam::111122223333:role/CoderhelmReadOnly"
        ],
        "Condition": {
          "StringEquals": {
            "aws:ResourceAccount": "111122223333"
          }
        }
      },
      {
        "Sid": "ReadRolesHereAssumeOnly",
        "Effect": "Deny",
        "Action": [
          "sts:AssumeRoleWithWebIdentity",
          "sts:AssumeRoleWithSAML",
          "sts:TagSession",
          "sts:SetSourceIdentity"
        ],
        "Resource": [
          "arn:aws:iam::111122223333:role/CoderHelmLogReader",
          "arn:aws:iam::111122223333:role/CoderhelmReadOnly"
        ]
      },
      {
        "Sid": "ReadRolesHereOnlyGatewayAndWorker",
        "Effect": "Deny",
        "Action": "sts:AssumeRole",
        "Resource": [
          "arn:aws:iam::111122223333:role/CoderHelmLogReader",
          "arn:aws:iam::111122223333:role/CoderhelmReadOnly"
        ],
        "Condition": {
          "StringNotEquals": {
            "aws:PrincipalTag/coderhelm:role": [
              "gateway",
              "worker"
            ]
          }
        }
      },
      {
        "Sid": "RuntimeTagOnlyByDeploy",
        "Effect": "Deny",
        "Action": [
          "iam:CreateRole",
          "iam:TagRole",
          "iam:UntagRole"
        ],
        "Resource": "*",
        "Condition": {
          "ForAnyValue:StringEqualsIgnoreCase": {
            "aws:TagKeys": [
              "coderhelm:role"
            ]
          },
          "ArnNotEquals": {
            "aws:PrincipalArn": "arn:aws:iam::111122223333:role/coderhelm-prod-deploy-stack"
          }
        }
      }
    ]
  },
