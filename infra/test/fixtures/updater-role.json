          "Effect": "Allow",
          "Resource": "arn:aws:ssm:us-east-1:111122223333:parameter/coderhelm-prod/distribution-domain",
          "Sid": "DomainTarget"
        },
        {
          "Action": [
            "ssm:GetParameter",
            "ssm:PutParameter",
            "ssm:DeleteParameter"
          ],
          "Effect": "Allow",
          "Resource": "arn:aws:ssm:us-east-1:111122223333:parameter/coderhelm-prod/uninstall/delete-data",
          "Sid": "UninstallSwitch"
        },
        {
          "Action": "lambda:InvokeFunction",
          "Effect": "Allow",
          "Resource": "arn:aws:lambda:us-east-1:111122223333:function:coderhelm-prod-install-helper",
          "Sid": "StageReleaseFiles"
        },
        {
          "Action": "s3:GetObject",
          "Effect": "Allow",
          "Resource": "arn:aws:s3:::coderhelm-prod-release-111122223333/releases/*",
          "Sid": "ReadStagedTemplates"
        },
        {
          "Action": "cloudformation:CreateChangeSet",
          "Condition": {
            "StringLike": {
              "cloudformation:TemplateUrl": [
                "https://coderhelm-public.s3.amazonaws.com/launch/v*.*.*/coderhelm.json",
                "https://coderhelm-prod-release-111122223333.s3.us-east-1.amazonaws.com/releases/v*.*.*/held/coderhelm.json"
              ]
            },
            "StringEqualsIfExists": {
              "cloudformation:RoleArn": "arn:aws:iam::111122223333:role/coderhelm-prod-deploy-stack"
            }
          },
          "Effect": "Allow",
          "Resource": "arn:aws:cloudformation:us-east-1:111122223333:stack/coderhelm-prod/*",
          "Sid": "ProposeReleaseUpdate"
        },
        {
          "Action": "cloudformation:CreateChangeSet",
          "Condition": {
            "StringLikeIfExists": {
              "cloudformation:TemplateUrl": [
                "https://coderhelm-prod-release-111122223333.s3.us-east-1.amazonaws.com/releases/v*.*.*/stacks/*.json"
              ]
            },
            "StringEqualsIfExists": {
              "cloudformation:RoleArn": "arn:aws:iam::111122223333:role/coderhelm-prod-deploy-stack"
            }
          },
          "Effect": "Allow",
          "Resource": "arn:aws:cloudformation:us-east-1:111122223333:stack/coderhelm-prod-*/*",
          "Sid": "ProposePartUpdates"
        },
        {
          "Action": "cloudformation:CreateChangeSet",
          "Condition": {
            "StringEqualsIfExists": {
              "cloudformation:RoleArn": "arn:aws:iam::111122223333:role/coderhelm-prod-deploy-stack"
            }
          },
          "Effect": "Allow",
          "Resource": "arn:aws:cloudformation:us-east-1:aws:transform/LanguageExtensions",
          "Sid": "ProposeThroughTransform"
        },
        {
          "Action": [
            "cloudformation:DescribeChangeSet",
